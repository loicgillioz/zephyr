menuconfig GPIO_PCA953X
	bool "PCA953X I2C GPIO chip"
	default y
	depends on DT_HAS_NXP_PCA9539_ENABLED || DT_HAS_NXP_PCA9538_ENABLED || DT_HAS_NXP_PCA9537_ENABLED || DT_HAS_NXP_PCA9536_ENABLED || DT_HAS_NXP_PCA9535_ENABLED || DT_HAS_NXP_PCA9534_ENABLED
	select I2C
	help
	  Enable driver for PCA953X I2C GPIO mux/demux series.

if GPIO_PCA953X

config GPIO_PCA953X_INIT_PRIORITY
	int "Init priority"
	default 70
	help
	  Device driver initialization priority.

endif # GPIO_PCA953X
